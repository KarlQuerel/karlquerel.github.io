{
  "name": "karlquerel.github.io",
  "version": "1.0.0",
  "description": "Personal portfolio website - retro pixel aesthetic (Vue 3 + Vite)",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "serve": "vite preview",
    "test": "playwright test",
    "deploy": "npm run build && gh-pages -d dist",
    "format": "prettier --write \"src/**/*.{js,vue,css,scss}\" --config .prettierrc && npm run lint:fix && npm run lint:check",
    "format:check": "prettier --check \"src/**/*.{js,vue,css,scss}\" --config .prettierrc",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "lint:check": "eslint . --cache --max-warnings 0",
    "clean": "npm run format",
    "prepare": "simple-git-hooks"
  },
  "author": "Karl Querel",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "lint-staged": {
    "*.{js,vue}": [
      "eslint --cache --fix",
      "prettier --write --config .prettierrc"
    ],
    "*.{css,scss}": "prettier --write --config .prettierrc"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.11.1",
    "gh-pages": "^6.3.0",
    "globals": "^17.12.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.6.2",
    "sass": "^1.85.0",
    "simple-git-hooks": "^2.13.1",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "typeit": "^8.7.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  }
}
