{
  "permissions": {
    "allow": [
      "Bash(rtk npm run *)",
      "Bash(npm run *)",
      "Bash(rtk git *)",
      "Bash(rtk diff *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/repo-rules.py\" prompt"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/repo-rules.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Auto-cleaning edited file",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-edited.py\""
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  }
}
